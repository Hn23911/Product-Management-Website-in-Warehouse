@model string  // Kiểu dữ liệu model là string để lưu email người dùng cần khóa

@{
    ViewData["Title"] = "Lock User";
}

<h2>@ViewData["Title"]</h2>

<div class="row">
    <div class="col-md-4">
        <form method="post" action="@Url.Action("LockUser", "Admin")">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label for="email">Email:</label>
                <input type="email" class="form-control" id="email" name="email" value="@Model" readonly />
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-danger">Lock User</button>
                <a asp-action="Users" asp-controller="Admin" class="btn btn-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>
